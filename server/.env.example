# Port the API listens on (Render sets this automatically)
PORT=8080
# Local: mongodb://127.0.0.1:27017/my-mechanic   Atlas: mongodb+srv://<user>:<pass>@<cluster>/my-mechanic
MONGO_URL=mongodb://127.0.0.1:27017/my-mechanic
# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Used by `npm run seed:admin` to create the first admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@mymechanic.dev
ADMIN_PASSWORD=change-me-8chars-min
# New accounts allowed per IP per hour (default 10)
# REGISTER_RATE_LIMIT=10
